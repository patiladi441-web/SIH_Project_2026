# ─────────────────────────────────────────────────────────────────────────────
# OceanEmbed Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL + PostGIS connection string (asyncpg driver)
DB_URL=postgresql+asyncpg://oceanembed:secret@localhost:5432/oceanembed

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Engine (model: in-memory PyTorch transformer | mock: synthetic | http://...: microservice)
AI_ENGINE_URL=model

# ── Grid / depth settings ─────────────────────────────────────────────────────
# Resolution in degrees for batch pre-computation
GRID_RESOLUTION=0.25

# Fixed depth levels (meters) — must match what the AI model outputs
# Use JSON array format (brackets required)
DEPTH_LEVELS=[0, 5, 10, 20, 30, 50, 75, 100, 125, 150, 200, 300, 500, 700, 1000]

# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_SECONDS=86400  # 24 hours

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development       # development | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security (future) ────────────────────────────────────────────────────────
# ADMIN_API_KEY=changeme
