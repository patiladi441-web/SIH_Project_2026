# ─────────────────────────────────────────────────────────────────────────────
# OceanEmbed Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL + PostGIS connection string (asyncpg driver)
DB_URL=postgresql+asyncpg://oceanembed:secret@localhost:5432/oceanembed

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Engine (mock by default — replace URL when real model is ready) ────────
# When the AI team deploys their Docker image, set this to:
#   AI_ENGINE_URL=http://ai-engine:8001
AI_ENGINE_URL=mock

# ── Grid / depth settings ─────────────────────────────────────────────────────
# Resolution in degrees for batch pre-computation
GRID_RESOLUTION=0.25

# Fixed depth levels (meters) — must match what the AI model outputs
# Use JSON array format (brackets required)
DEPTH_LEVELS=[0,10,20,50,100,200,500,1000,1500,2000]

# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development       # development | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security (future) ────────────────────────────────────────────────────────
# ADMIN_API_KEY=changeme
