*.py[cod]
*$py.class
*.so

# Packaging & Builds
*.egg-info/
dist/
build/
.eggs/
*.egg

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Jupyter Notebooks
.ipynb_checkpoints/

# Data & Databases
data/raw/
data/processed/
*.nc
*.sqlite
*.sqlite3
*.db

# Logs
logs/
*.log

# Editor & OS files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

